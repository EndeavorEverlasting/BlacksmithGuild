{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blacksmithguild/schemas/disposable-save-registry.schema.json",
  "title": "TbgDisposableSaveRegistry.v1",
  "type": "object",
  "required": [
    "schema",
    "policy",
    "compatibility",
    "namePatterns",
    "ownedCanonical",
    "cohorts",
    "proofBoundary"
  ],
  "properties": {
    "schema": { "const": "TbgDisposableSaveRegistry.v1" },
    "description": { "type": "string" },
    "policy": { "type": "string" },
    "activePinRelativePath": { "type": "string" },
    "classificationArtifact": { "type": "string" },
    "updater": { "type": "string" },
    "compatibility": {
      "type": "object",
      "required": ["registry", "supportedGameVersionPrefix"],
      "properties": {
        "registry": { "type": "string" },
        "supportedGameVersionPrefix": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "namePatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "ownedCanonical": {
      "type": "object",
      "required": ["id", "leafName", "createPrefix"],
      "properties": {
        "id": { "type": "string" },
        "leafName": { "type": "string" },
        "role": { "type": "string" },
        "preferredRoot": { "type": "array", "items": { "type": "string" } },
        "createPrefix": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "match", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["Disposable", "NonDisposable", "Unknown"]
          },
          "match": { "type": "array", "items": { "type": "string" } },
          "purpose": { "type": "string" },
          "knownMembers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "proofBoundary": { "type": "string" }
  }
}
